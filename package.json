{
  "name": "create-hats-app",
  "type": "module",
  "version": "0.0.14",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "create-hats-app": "./dist/index.js"
  },
  "scripts": {
    "next:dev": "nx run create-hats-next-app:serve",
    "next:build": "nx run create-hats-next-app:build",
    "vite:dev": "pnpm run --filter create-hats-vite-app dev",
    "vite:build": "pnpm run --filter create-hats-vite-app build",
    "remix:dev": "pnpm run --filter create-hats-remix-vite-app dev",
    "remix:build": "pnpm run --filter create-hats-remix-vite-app build",
    "sdk:dev": "pnpm run --filter @hatsprotocol/react-sdk dev",
    "sdk:build": "pnpm run --filter @hatsprotocol/react-sdk build",
    "storybook": "pnpm run --filter @hatsprotocol/hats-ui storybook"
  },
  "files": [
    "dist/**/*",
    "apps/**/*",
    "!apps/**/node_modules/**",
    "!apps/**/dist/**",
    "!apps/next-app/.next/**"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fs-extra": "^11.2.0",
    "parser": "link:@typescript/eslint/parser",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@hatsprotocol/modules-sdk": "^1.3.0",
    "@hatsprotocol/sdk-v1-core": "^0.10.0",
    "@hatsprotocol/sdk-v1-subgraph": "^1.0.0",
    "@nrwl/eslint-plugin-nx": "^19.8.4",
    "@nrwl/node": "^19.8.4",
    "@nx/devkit": "^20.3.1",
    "@nx/eslint": "^20.3.1",
    "@nx/eslint-plugin": "^20.3.1",
    "@nx/js": "^20.3.1",
    "@nx/next": "^20.3.1",
    "@nx/node": "^20.3.1",
    "@nx/plugin": "^20.3.1",
    "@nx/react": "^20.3.1",
    "@nx/remix": "^20.3.1",
    "@nx/vite": "^20.3.1",
    "@nx/web": "^20.3.1",
    "@types/prompts": "^2.4.9",
    "cac": "^6.7.14",
    "cross-spawn": "^7.0.3",
    "nx": "^20.3.1",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },
  "packageManager": "pnpm@9.0.6"
}
